# ==============================================================================
# DEIS Environment Configuration
# ==============================================================================

# Port Web Server di Host (Akses via http://localhost:8085)
APP_PORT=8085
APP_URL=http://localhost:8085
APP_ENV=development

# Konfigurasi Database Utama (DEIS)
# Nilai default 'localhost' akan otomatis menggunakan Unix Socket host jika dimount
DB_HOST=localhost
DB_PORT=3306
DB_NAME=deis_db
DB_USERNAME=root
DB_PASSWORD=rony123

# Konfigurasi Database OBE (Read-Only)
OBE_DB_NAME=obe_cpl
OBE_DB_USERNAME=root
OBE_DB_PASSWORD=rony123
